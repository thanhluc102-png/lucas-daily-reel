{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lucas.vn/schema/scenes.schema.json",
  "title": "Lucas video job",
  "type": "object",
  "required": ["version", "job_id", "format", "products", "scenes", "cta"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "job_id": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}_[a-z0-9]{5}$" },
    "title": { "type": "string" },
    "format": { "enum": ["hook", "premium", "unbox", "podcast", "threads"] },
    "aspect": { "const": "9:16", "default": "9:16" },

    "brand": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bg": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$", "default": "#0B1B2E" },
        "accent": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$", "default": "#C9A227" }
      }
    },

    "audio": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "voice_path": { "type": "string" },
        "voice_provider": { "enum": ["elevenlabs", "fptai"] },
        "gender": { "enum": ["nu", "nam"] },
        "region": { "enum": ["mien_nam", "mien_bac"] },
        "speed": { "type": "number", "minimum": 0.8, "maximum": 1.4, "default": 1.05 },
        "bgm": { "type": "string", "default": "auto" },
        "bpm": { "type": "integer", "minimum": 60, "maximum": 220, "default": 195 }
      }
    },

    "subtitle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "style": { "enum": ["karaoke", "pill", "plain"], "default": "karaoke" },
        "words_path": { "type": "string" }
      }
    },

    "products": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sku", "name", "price_vnd", "url", "image"],
        "additionalProperties": false,
        "properties": {
          "sku": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "price_vnd": { "type": "integer", "minimum": 1000 },
          "regular_vnd": { "type": ["integer", "null"], "minimum": 1000 },
          "discount_pct": { "type": "integer", "minimum": 0, "maximum": 90 },
          "price_is_from": {
            "type": "boolean",
            "default": false,
            "description": "true khi là sản phẩm biến thể — giá là giá thấp nhất, lời thoại BẮT BUỘC kèm 'chỉ từ'"
          },
          "url": { "type": "string", "format": "uri" },
          "image": { "type": "string" }
        }
      }
    },

    "scenes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 14,
      "items": {
        "type": "object",
        "required": ["idx", "role", "text", "duration_sec", "asset"],
        "additionalProperties": false,
        "properties": {
          "idx": { "type": "integer", "minimum": 0 },
          "role": { "enum": ["hook", "body", "proof", "price", "cta"] },
          "text": { "type": "string", "minLength": 1 },
          "duration_sec": { "type": "number", "minimum": 1.5, "maximum": 8 },
          "sku_ref": { "type": "string", "description": "SKU của sản phẩm được nhắc ở cảnh này" },
          "asset": {
            "type": "object",
            "required": ["type"],
            "additionalProperties": false,
            "properties": {
              "type": { "enum": ["product_image", "ai_image", "stock_video", "existing_footage"] },
              "src": { "type": "string" },
              "prompt": { "type": "string", "description": "Chỉ dùng khi type = ai_image" },
              "focus": { "enum": ["center", "top", "bottom"], "default": "center" }
            }
          },
          "overlay": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "price_badge": { "type": "boolean", "default": false },
              "label": { "type": "string", "maxLength": 24 }
            }
          }
        }
      }
    },

    "cta": {
      "type": "object",
      "required": ["text", "url"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string", "maxLength": 60 },
        "url": { "type": "string", "format": "uri" }
      }
    }
  }
}
